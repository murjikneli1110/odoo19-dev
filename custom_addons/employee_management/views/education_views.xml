<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_education_list" model="ir.ui.view">
        <field name="name">custom.education.list</field>
        <field name="model">custom.education</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id" />
                <field name="institution" />
                <field name="degree" />
                <field name="field_of_study" />
                <field name="start_date" />
                <field name="end_date" />
            </list>
        </field>
    </record>

    <record id="view_education_form" model="ir.ui.view">
        <field name="name">custom.education.form</field>
        <field name="model">custom.education</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" />
                            <field name="institution" />
                            <field name="degree" />
                            <field name="field_of_study" />
                        </group>
                        <group>
                            <field name="start_date" />
                            <field name="end_date" />
                            <field name="is_current" readonly="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_education" model="ir.actions.act_window">
        <field name="name">Education</field>
        <field name="res_model">custom.education</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>