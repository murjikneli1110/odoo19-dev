<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_payroll_wizard_form" model="ir.ui.view">
        <field name="name">custom.payroll.wizard.form</field>
        <field name="model">custom.payroll.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Payroll">
                <group>
                    <field name="employee_id" readonly="1" />
                    <field name="year" />
                    <field name="month" />
                </group>
                <footer>
                    <button 
                        name="action_generate_payroll"
                        type="object"
                        string="Generate Payroll"
                        class="btn-primary"
                    />

                    <button 
                        string="Cancel"
                        special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_payroll_wizard" model="ir.actions.act_window">
        <field name="name">Generate Payroll</field>
        <field name="res_model">custom.payroll.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field> <!-- popup -->
    </record>


    <record id="view_payroll_list" model="ir.ui.view">
        <field name="name">custom.payroll.list</field>
        <field name="model">custom.payroll</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button 
                        name="%(action_payroll_wizard)d"
                        type="action"
                        string="Generate Payroll"
                        class="btn-primary"
                        display="always"
                    />
                </header>

                <field name="employee_id" />
                <field name="year" />
                <field name="month" />
                <field name="salary" />
                <field name="net_hours" />
                <field name="gross_pay" />
                <field name="calculated_at" />
            </list>
        </field>
    </record>

    <record id="view_payroll_form" model="ir.ui.view">
        <field name="name">custom.payroll.form</field>
        <field name="model">custom.payroll</field>
        <field name="arch" type="xml">
            <form edit="0">
                <sheet>
                    <group>
                        <group>
                            <group>
                                <field name="employee_id" />
                                <field name="year" />
                                <field name="month" />
                                <field name="salary" />
                                <field name="adjustment" />
                                <field name="gross_pay" />
                                <field name="calculated_at" />
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="expected_hours" />
                                <field name="worked_hours" />
                                <field name="overtime_hours" />
                                <field name="weekend_hours" />
                                <field name="undertime_hours" />
                                <field name="net_hours" />
                                <field name="hourly_rate" />
                            </group>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_payroll" model="ir.actions.act_window">
        <field name="name">Payroll</field>
        <field name="res_model">custom.payroll</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>