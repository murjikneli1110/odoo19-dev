<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_department_list" model="ir.ui.view">
        <field name="name">custom.department.list</field>
        <field name="model">custom.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="parent_id" />
                <field name="manager_id" />
            </list>
        </field>
    </record>

    <record id="view_department_form" model="ir.ui.view">
        <field name="name">custom.department.form</field>
        <field name="model">custom.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="parent_id" />
                        <field name="manager_id" />
                    </group>
                    
                    <notebook>
                        <page string="Employees">
                            <field name="employee_ids">
                                <list>
                                    <field name="first_name" />
                                    <field name="last_name" />
                                    <field name="user_id" />
                                    <field name="is_department_admin" />
                                </list>
                            </field>
                        </page>

                        <page string="Child Departments">
                            <field name="child_ids">
                                <list>
                                    <field name="name" />
                                    <field name="manager_id" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">custom.department</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>