<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_trait_list" model="ir.ui.view">
        <field name="name">custom.trait.list</field>
        <field name="model">custom.trait</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="employee_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>

    <record id="view_trait_form" model="ir.ui.view">
        <field name="name">custom.trait.form</field>
        <field name="model">custom.trait</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_trait" model="ir.actions.act_window">
        <field name="name">Traits</field>
        <field name="res_model">custom.trait</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>