<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_position_list" model="ir.ui.view">
        <field name="name">custom.position.list</field>
        <field name="model">custom.position</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id" />
                <field name="title" />
                <field name="start_date" />
                <field name="end_date" />
            </list>
        </field>
    </record>

    <record id="view_position_form" model="ir.ui.view">
        <field name="name">custom.position.form</field>
        <field name="model">custom.position</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="employee_id" />
                        <field name="title" />
                        <field name="start_date" />
                        <field name="end_date" />
                        <field name="is_current" readonly="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_position" model="ir.actions.act_window">
        <field name="name">Positions</field>
        <field name="res_model">custom.position</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>